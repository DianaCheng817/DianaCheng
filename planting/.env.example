# ============================================================
# 环境变量样例：复制为 .env 后按实际填写；.env 已被 .gitignore 忽略
# 本地不配置时，服务使用 config.yaml 默认值与演示账号
# ============================================================

# ---------- 鉴权 ----------
# JWT 签名密钥：生产部署必须改为随机长字符串（可用 python -c "import secrets;print(secrets.token_hex(32))" 生成）
JWT_SECRET=
# 首次启动初始化的管理员账号（仅台账中不存在管理员时写入一次）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- 远程兼容 OpenAI 协议模型（云端部署通道，可选） ----------
# 不配置则云端自动降级为证据模板；本地 Ollama 通道优先于本通道
REMOTE_LLM_ENABLED=false
REMOTE_LLM_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
REMOTE_LLM_MODEL=deepseek-chat

# ---------- 本地 Ollama（仅本机调试用，云端容器内一般不启用） ----------
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:0.6b
